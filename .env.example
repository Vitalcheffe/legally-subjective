# Legally Subjective — environment template
# Copy to .env and fill in. Never commit .env.

# CourtListener API token (free registration: https://www.courtlistener.com/profile/api/)
# Optional: anonymous access works for search, but a token raises rate limits.
COURTLISTENER_TOKEN=

# LLM backend used by `preprocess.py --llm` (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
