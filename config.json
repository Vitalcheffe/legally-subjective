   },
   {
    "label": "2018",
    "filed_after": "2018-01-01",
    "filed_before": "2018-12-31"
   },
   {
    "label": "2019",
    "filed_after": "2019-01-01",
    "filed_before": "2019-12-31"
   },
   {
    "label": "2020",
    "filed_after": "2020-01-01",
    "filed_before": "2020-12-31"
   }
  ],
