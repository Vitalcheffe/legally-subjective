    "take": 1
   },
   {
    "label": "2020",
    "filed_after": "2020-01-01",
    "filed_before": "2020-12-31",
    "take": 1
   }
  ]
 },
 "paths": {
  "cases_jsonl": "data/sample/cases.jsonl",
  "documents_dir": "data/sample/documents",
  "fetch_log": "data/sample/FETCH_LOG.json",
  "checkpoint": "data/sample/.checkpoint.json"
 },
 "corpus": {
  "query": "\"judgment of conviction\"",
  "case_type": "o",
  "court": "nyappdiv",
  "order_by": "dateFiled asc",
  "page_size": 20,
  "criminal_keywords": [
   "judgment of conviction",
   "convicted",
   "defendant"
  ],
  "require_all_keywords": false,
  "target_usable": 1000,
  "document_channel_preference": [
   "courtlistener-storage",
   "official"
  ],
  "windows": [
   {
    "label": "2016",
    "filed_after": "2016-01-01",
    "filed_before": "2016-12-31"
   },
   {
    "label": "2017",
    "filed_after": "2017-01-01",
