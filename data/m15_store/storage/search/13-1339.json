, 103349, 104181, 109005, 109086, 109087, 109301, 109462, 109815, 110056, 110099, 110599, 110654, 110916, 111258, 111661, 111982, 112305, 112348, 112418, 112747, 112881, 118146, 118217, 118329, 118368, 145658, 145749, 145783, 145904, 145905, 149022, 2620886], "download_url": "http://www.supremecourt.gov/opinions/15pdf/13-1339_f2q3.pdf", "id": 3203656, "joined_by_ids": [], "local_path": "pdf/2016/05/16/spokeo_inc._v._robins.pdf", "meta": {"timestamp": "2026-03-12T18:45:07.270437Z", "date_created": "2016-05-16T15:01:26.335844Z"}, "ordering_key": null, "per_curiam": false, "sha1": "3c6e6c5c66717065e521688539e3a45ec95cbc60", "snippet": "(Slip Opinion)              OCTOBER TERM, 2015                                       1\n\n                                       Syllabus\n\n         NOTE: Where it is feasible, a syllabus (headnote) will be released, as is\n       being done in connection with this case, at the time the opinion is issued.\n       The syllabus constitutes no part of the opinion of the Court but has been\n       prepared by the Reporter of Decisions for the convenience of the reader.\n       See United States v. Detroit ", "type": "combined-opinion"}, {"author_id": null, "cites": [], "download_url": null, "id": 9823248, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2026-03-12T18:45:07.270437Z", "date_created": "2023-09-01T09:50:55.630870Z"}, "ordering_key": 1, "per_curiam": false, "sha1": "", "snippet": "\nJustice ALITOdelivered the opinion of the Court.\nThis case presents the question whether respondent Robins has standing to maintain an action in federal court against petitioner Spokeo under the Fair Credit Reporting Act of 1970 (FCRA or Act), 84 Stat. 1127, as amended, ", "type": "lead-opinion"}, {"author_id": null, "cites": [], "download_url": null, "id": 9823249, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2026-03-12T18:45:07.270437Z", "date_created": "2023-09-01T09:50:55.638921Z"}, "ordering_key": 2, "per_curiam": false, "sha1": "", "snippet": "\nJustice THOMAS, concurring.\nThe Court vacates and remands to have the Court of Appeals determine \"whether the particular procedural violations alleged in this case entail a degree of risk sufficient to meet the concreteness requirement.\" Ante, at 1550. In defining what constitutes a concrete injury, the Court explains that \"concrete\" means \" 'real,' \" and \"not 'abstract,' \" but is not \"necessarily synonymous with 'tang", "type": "concurrence-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "2015-010", "sibling_ids": [3203656, 9823248, 9823249], "source": "CU", "status": "Published", "suitNature": "", "syllabus": ""}, {"absolute_url": "/opinion/8174377/spokeo-inc-v-robins/", "attorney": "", "caseName": "Spokeo, Inc. v. Robins", "caseNameFull": "SPOKEO, INC. v. Thomas ROBINS.", "citation": ["135 S. Ct. 1892", "191 L. Ed. 2d 762", "83 U.S.L.W. 3819", "2015 U.S. LEXIS 2947"], "citeCount": 0, "cluster_id": 8174377, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2015-04-27", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 13\u20131339.", "docket_id": 65271193, "judge": "", "lexisCite": "2015 U.S. LEXIS 2947", "meta": {"timestamp": "2024-06-22T17:25:28.757555Z", "date_created": "2022-09-09T17:52:44.204747Z", "score": {"bm25": 83.979935}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 8136154, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2024-06-25T03:02:10.324106Z", "date_created": "2022-09-09T17:52:44.216545Z"}, "ordering_key": null, "per_curiam": false, "sha1": "", "snippet": "\nPetition for writ of certiorari to the United States Court of Appeals for the Ninth Circuit granted.\n", "type": "lead-opinion"}], "panel_ids": [], "panel_nam