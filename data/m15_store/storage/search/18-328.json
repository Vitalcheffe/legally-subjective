rce": "C", "status": "Published", "suitNature": "", "syllabus": ""}, {"absolute_url": "/opinion/9231275/rotkiske-v-klemm/", "attorney": "Scott E. Gant, Washington, DC, for the petitioner, Shay Dvoretzky, Washington, DC, for the respondents, Jonathan C. Bond for the United States as amicus curiae, by special leave of the Court, supporting the respondents., Matthew B. Weisberg, Weisberg Law, Morton, PA, Scott E. Gant, Samuel S. Ungar, Boies Schiller Flexner LLP, Washington, DC, for petitioner., Amanda K. Rice, Jones Day, Detroit, MI, Shay Dvoretzky, Jeffrey R. Johnson, Jones Day, Washington, DC, for respondent Paul Klemm.", "caseName": "Rotkiske v. Klemm", "caseNameFull": "Kevin C. ROTKISKE v. Paul KLEMM", "citation": ["589 U.S. 8", "140 S. Ct. 355", "205 L. Ed. 2d 291"], "citeCount": 370, "cluster_id": 9231275, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2019-12-10", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 18-328", "docket_id": 66497693, "judge": "Sotomayor, Thomas", "lexisCite": "", "meta": {"timestamp": "2025-10-27T18:36:44.431728Z", "date_created": "2022-11-28T14:55:17.933001Z", "score": {"bm25": 215.00664}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 9226081, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:44.439185Z", "date_created": "2022-11-28T14:55:17.941644Z"}, "ordering_key": 1, "per_curiam": false, "sha1": "", "snippet": "\nJustice THOMAS delivered the opinion of the Court.\nThe Fair Debt Collection Practices Act (FDCPA) authorizes private civil actions against debt collectors who engage in certain prohibited practices. 91 Stat. 881, 15 U.S.C. \u00a7 1692k(a). An action under the FDCPA may be brought \"within one year from the date on which the viola", "type": "lead-opinion"}, {"author_id": null, "cites": [], "download_url": null, "id": 9226082, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:44.439185Z", "date_created": "2022-11-28T14:55:17.946382Z"}, "ordering_key": 2, "per_curiam": false, "sha1": "", "snippet": "\nJustice SOTOMAYOR, concurring.\nLike my colleagues in both the majority and the partial dissent, I agree that 15 U.S.C. \u00a7 1692k(d) is a one-year statute of limitations that typically begins to run when the alleged violation \"occurs,\" not when the plaintiff discovers it. Compare ante , at 358, with post , at 362 (GINSBURG, J., dissenting in part and from judgment). The only daylight between the majority and diss", "type": "concurrence-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [9226081, 9226082], "source": "U", "status": "Published", "suitNature": "", "syllabus": ""}, {"absolute_url": "/opinion/9346554/rotkiske-v-klemm/", "attorney": "", "caseName": "Rotkiske v. Klemm", "caseNameFull": "Kevin C. ROTKISKE v. Paul KLEMM", "citation": ["140 S. Ct. 27", "204 L. Ed. 2d 1182"], "citeCount": 0, "cluster_id": 9346554, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2019-08-23", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 18\u2013328.", "docket_id": 66659472, "judge": "", "lexisCite": "", "meta": {"timestamp": "2024-06-23T00:52:57.480442Z", "date_created": "2022-12-16T21:22:39.401363Z", "score": {"bm25": 87.83335}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 9342001, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2024-06-25T07:23:21.602134Z", "date_created": "2022-12-16T21:22:39.410959Z"}, "ordering_key": null, "per_curiam": false, "sha1": "", "snippet": "Motion of the Solicitor General f