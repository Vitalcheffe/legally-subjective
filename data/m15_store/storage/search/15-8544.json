749, "cluster_id": 8176305, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2017-03-06", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 15\u20138544.", "docket_id": 65273253, "judge": "Kennedy, Thomas", "lexisCite": "2017 U.S. LEXIS 1572", "meta": {"timestamp": "2025-10-27T18:36:05.320037Z", "date_created": "2022-09-09T18:09:02.639120Z", "score": {"bm25": 99.90089}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 8138088, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:05.410858Z", "date_created": "2022-09-09T18:09:02.654530Z"}, "ordering_key": 1, "per_curiam": false, "sha1": "", "snippet": "\nJustice THOMAS delivered the opinion of the Court.\nAt the time of petitioner's sentencing, the advisory Sentencing Guidelines included a residual clause defining a \"crime of violence\" as an offense that \"involves conduct that presents a serious potential risk of physical injury to another.\" United States Sentencing Commission, Guidelines Manual \u00a7 4B1.2(a)(2) (Nov. 2006) (U.S.S.G.). This Court held in Johnson v. United States,<", "type": "lead-opinion"}, {"author_id": null, "cites": [], "download_url": null, "id": 8138089, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:05.410858Z", "date_created": "2022-09-09T18:09:02.662909Z"}, "ordering_key": 2, "per_curiam": false, "sha1": "", "snippet": "\nJustice KENNEDY, concurring.\nAs sentencing laws and standards continue to evolve, cases may arise in which the formulation of a sentencing provision leads to a sentence, or a pattern of sentencing, challenged as so arbitrary that it implicates constitutional concerns. In that instance, a litigant might use the word vague in a general sense-that is to say, imprecise or unclear-in trying to establish that the sentencing decision ", "type": "concurrence-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [8138088, 8138089], "source": "U", "status": "Published", "suitNature": "", "syllabus": ""}]}]