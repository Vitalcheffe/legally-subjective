[{"count": 6, "next": null, "previous": null, "results": [{"absolute_url": "/opinion/4623614/nieves-v-bartlett/", "attorney": "", "caseName": "Nieves v. Bartlett", "caseNameFull": "", "citation": ["587 U.S. 391", "139 S. Ct. 1715", "204 L. Ed. 2d 1", "2019 U.S. LEXIS 3557"], "citeCount": 65, "cluster_id": 4623614, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2019-05-28", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "17-1174", "docket_id": 15682001, "judge": "John G. Roberts", "lexisCite": "2019 U.S. LEXIS 3557", "meta": {"timestamp": "2025-10-27T18:33:56.046079Z", "date_created": "2019-05-28T15:01:02.252936Z", "score": {"bm25": 252.14568}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": 2738, "cites": [87431, 91704, 96405, 97600, 100265, 101097, 106170, 109387, 109573, 109574, 110763, 111611, 111919, 112257, 112881, 117864, 118022, 118036, 118156, 118203, 137733, 145662, 163905, 167269, 186304, 197117, 216733, 217703, 781691, 782629, 790592, 796114, 801500, 1507366, 2562091, 2620702], "download_url": "https://www.supremecourt.gov/opinions/18pdf/17-1174_m5o1.pdf", "id": 4400867, "joined_by_ids": [], "local_path": "pdf/2019/05/28/nieves_v._bartlett.pdf", "meta": {"timestamp": "2025-10-27T18:33:56.062347Z", "date_created": "2019-05-28T15:01:02.279612Z"}, "ordering_key": null, "per_curiam": false, "sha1": "d0e08ad10a4a6f05f5adae489953573b4fc69da5", "snippet": "(Slip Opinion)              OCTOBER TERM, 2018                                       1\n\n                                       Syllabus\n\n         NOTE: Where it is feasible, a syllabus (headnote) will be released, as is\n       being done in connection with this case, at the time the opinion is issued.\n       The syllabus constitutes no part of the opinion of the Court but has been\n       prepared by the Reporter of Decisions for the convenience of the reader.\n       See United States v. Detroit ", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "2018-033", "sibling_ids": [4400867], "source": "C", "status": "Published", "suitNature": "", "syllabus": ""}, {"absolute_url": "/opinion/9231236/nieves-v-bartlett/", "attorney": "Jahna Lindemuth, Attorney General, Dario Borghesan, Anna R. Jay, Stephanie Galbraith Moore, Anchorage, AK, for Petitioners., Jeffrey L. Fisher, Pamela S. Karlan, Leah M. Litman, Stanford Law School, Supreme Court, Litigation Clinic, Stanford, CA, Kerri L. Barsh, Greenberg Traurig, Miami, FL, Zane D. Wilson, Tyler P. Broker, CSG, Inc., Fairbanks, AK, for Respondent.", "caseName": "Nieves v. Bartlett", "caseNameFull": "Luis A. NIEVES v. Russell P. BARTLETT", "citation": ["587 U.S. 391", "139 S. Ct. 1715"], "citeCount": 1076, "cluster_id": 9231236, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2019-05-28", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 17-1174", "docket_id": 66497654, "judge": "Gorsuch, Roberts, Sotomayor", "lexisCite": "", "meta": {"timestamp": "2025-10-27T18:36:43.107046Z", "date_created": "2022-11-28T14:54:16.843517Z", "score": {"bm25": 214.32086}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 9226038, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:43.094823Z", "date_created": "2022-11-28T14:54:16.852423Z"}, "ordering_key": 1, "per_curiam": false, "sha1": "", "snippet": "\nChief Justice ROBERTS delivered the opinion of the Court.\n*1720Respondent Russell Bartlett sued petitioners-two police officers-alleging that they retaliated against him for his protected First Amendment speech by arresting him for disorderly conduct and resisting arrest. The officers had probable cause to arrest Bartlett, and we now decide ", "type": "lead-opinion"}, {"author_id": null, "cites": [], "download_url": null, "id": 9226039, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:43.094823Z", "date_created": "2022-11-28T14:54:16.857271Z"}, "ordering_key": 2, "per_curiam": false, "sha1": "", "snippet": "\nJustice GORSUCH, concurring in part and dissenting in part.\nNo one agrees who started the trouble at the 2014 Alaska Arctic Man Festival, but everyone agrees two troopers ended it by arresting Russell Bartlett for harassing one of them. And it's that arrest that led to this lawsuit. Mr. Bartlett alleges that the real reason the troopers arrested him had nothing to do with harassment and ev", "type": "in-part-opinion"}, {"author_id": null, "cites": [], "download_url": null, "id": 9226040, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2025-10-27T18:36:43.094823Z", "date_created": "2022-11-28T14:54:16.861780Z"}, "ordering_key": 3, "per_curiam": false, "sha1": "", "snippet": "\nJustice SOTOMAYOR, dissenting.\nWe granted certiorari to decide whether probable cause alone always suffices to defeat a First Amendment retaliatory arrest claim under 42 U.S.C. \u00a7 1983. The Court answers that question \"no\"-a correct and sensible bottom line on which eight Justices agree. There is no basis in \u00a7 19", "type": "dissent"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [9226038, 9226039, 9226040], "source": "U", "status": "Published", "suitNature": "", "syllabus": ""}, {"absolute_url": "/opinion/9338264/nieves-v-bartlett/", "attorney": "", "caseName": "Nieves v. Bartlett", "caseNameFull": "Luis A. NIEVES v. Russell P. BARTLETT.", "citation": ["139 S. Ct. 398", "202 L. Ed. 2d 308"], "citeCount": 0, "cluster_id": 9338264, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2018-10-26", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 17\u20131174.", "docket_id": 66648292, "judge": "", "lexisCite": "", "meta": {"timestamp": "2024-06-23T00:50:56.734964Z", "date_created": "2022-12-15T21:23:38.831762Z", "score": {"bm25": 175.57208}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 9333602, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2024-06-25T07:20:50.975038Z", "date_created": "2022-12-15T21:23:38.839695Z"}, "ordering_key": null, "per_curiam": false, "sha1": "", "snippet": "Motion of the Solicitor General for leave to participate in oral argument as amicus curiae and for divided argument granted.", "type": "lead-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [9333602], "source": "U", "status": "Published", "suitNature": "", "syllabus": ""}, {"absolute_url": "/opinion/9338102/nieves-v-bartlett/", "attorney": "", "caseName": "Nieves v. Bartlett", "caseNameFull": "Luis A. NIEVES v. Russell P. BARTLETT.", "citation": ["139 S. Ct. 358", "202 L. Ed. 2d 216"], "citeCount": 0, "cluster_id": 9338102, "court": "Supreme Court of the United States", "court_citation_string": "SCOTUS", "court_id": "scotus", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2018-10-09", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "No. 17\u20131174.", "docket_id": 66648124, "judge": "", "lexisCite": "", "meta": {"timestamp": "2024-06-23T00:50:54.435252Z", "date_created": "2022-12-15T21:22:44.674111Z", "score": {"bm25": 93.419914}}, "neutralCite": "", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [], "download_url": null, "id": 9333440, "joined_by_ids": [], "local_path": null, "meta": {"timestamp": "2024-06-25T07:20:46.461070Z", "date_created": 