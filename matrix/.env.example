# SQLite index (rebuilt deterministically by `bun scripts/ingest.ts`)
DATABASE_URL="file:../db/matrix.db"

# Where the legally-subjective corpus lives (default resolves ../
# relative to this folder — i.e. the repository root)
CORPUS_ROOT=".."

# The multi-agent engine (module 09) binds to z-ai-web-dev-sdk when run
# inside its sandbox. For an external OpenAI-compatible endpoint, the
# binding can be ported to LLM_BASE_URL / LLM_API_KEY like the Python
# pipeline (see config.json preprocess.llm).
